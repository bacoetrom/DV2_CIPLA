#include "tlpp-core.th"
#include "totvs.ch"

// Chaves (pedido|item|armazém destino) já autorizadas nesta sessão de edição,
// para não repetir o prompt de senha/justificativa a cada novo clique em
// Salvar enquanto o usuário não alterar novamente o valor da mesma linha.
Static aMT410TKVal := {} as Array

/*/{Protheus.doc} MT410TOK
Ponto de entrada real e documentado da rotina MATA410 (Pedido de Venda),
disparado pela rotina padrão ao confirmar a operação (botão Salvar) de
Inclusão, Alteração, Exclusão ou Cópia do pedido – sintaxe oficial
MT410TOK([nOpc], [aRecnoSE1RA]).

Ao confirmar o pedido, percorre todas as linhas de aCols e identifica
todos os itens que já existiam fisicamente gravados em SC6 e tiveram o
Armazém (C6_LOCAL) alterado. Uma linha nova (sem registro físico
anterior em SC6) nunca exige justificativa. Somente ao final do laço,
com todos os itens alterados já identificados, é exibida uma ÚNICA tela
de Assinatura Eletrônica (senha do próprio usuário logado + Justificativa),
listando todos os itens alterados de uma só vez; se confirmada, grava um
registro de auditoria por item alterado, numa única leva. O fluxo de
Assinatura Eletrônica (tela, validações de senha/chave e gravação do
registro de auditoria na tabela ZTL via U_ZTLGravaLog()) é delegado à
classe genérica ZTLAssinaEletronica (ver ZTLU002.tlpp), que reaproveita o
motor genérico de auditoria já usado por A010TOK e CICOMR01 (ver
ZTLU001.tlpp).

Substitui a implementação anterior "WM410LINE", que usava um nome de Ponto
de Entrada inexistente na rotina MATA410 e por isso nunca era chamada pela
rotina padrão.

PARAMIXB:
  [1] nOpc         - Numeric - Código da operação confirmada
  [2] aRecnoSE1RA  - Array   - Recnos de SE1/RA relacionados (não utilizado
                      nesta implementação)

@type user function
@author Pablo Regis
@since 15/09/2026
@return Logical, .T. permite a conclusão da operação / .F. não permite
@obs Não executado dentro de Begin/End Transaction (dispara antes da
gravação, ao clicar em Salvar). Não adicionar prefixo U_ na declaração da
função. Depende das variáveis Private aCols/aHeader e do alias SC5/SC6
posicionados pela rotina padrão MATA410.
@see MATA410
@see ZTLGravaLog
@see ZTLAssinaEletronica
/*/
User Function MT410TOK() as Logical

	Local nOpc  := 0  as Numeric
	Local lRet  := .T. as Logical

	If Type("PARAMIXB") == "A" .And. Len(PARAMIXB) >= 1 .And. ValType(PARAMIXB[1]) == "N"
		nOpc := PARAMIXB[1]
	EndIf

	// Operação de exclusão do pedido não exige validação de Armazém.
	If nOpc == 5
		Return .T.
	EndIf

	Try
		lRet := MT410TKVldGrid()
	Catch oError
		// Não mascarar a falha: se o erro for engolido e lRet forcado para
		// .T., a gravação do log de auditoria (um registro por item pendente,
		// em MT410TKAssinaLote/GravaLog) pode ter sido interrompida no meio,
		// deixando itens sem log e o usuário sem nenhum aviso.
		FWLogMsg("ERROR", , "MT410TOK", "MT410TOK", , "01", oError:Description, 0, 0, {})
		MsgStop("Falha ao validar a alteração de Armazém: " + oError:Description + CHR(13) + "As alterações não serão gravadas.", "MT410TOK")
		lRet := .F.
	EndTry

Return lRet

/*/{Protheus.doc} MT410TKVldGrid
Percorre todas as linhas não deletadas de aCols e acumula, em
aPendentes, todos os itens que tenham sido efetivamente alterados em
relação ao valor físico gravado em SC6 (Armazém). Ao final do laço, se
houver ao menos um item pendente, aciona uma ÚNICA validação de
Assinatura Eletrônica (senha + justificativa) cobrindo todos eles de
uma só vez.
@type static function
@author Pablo Regis
@since 15/09/2026
@return logical, .T. se não havia pendência ou se a Assinatura Eletrônica
foi confirmada para todos os itens pendentes; .F. se foi cancelada ou os
dados informados foram inválidos (bloqueia a gravação do pedido inteiro)
/*/
Static Function MT410TKVldGrid() as Logical

	Local nPosLocal  := 0  as Numeric
	Local nPosItem   := 0  as Numeric
	Local nI         := 0  as Numeric
	Local aPendentes := {} as Array
	Local lRet       := .T. as Logical

	If ValType(aCols) <> "A" .Or. ValType(aHeader) <> "A"
		Return .T.
	EndIf

	nPosLocal := aScan(aHeader, {|aCampo| AllTrim(aCampo[2]) == "C6_LOCAL"})
	nPosItem  := aScan(aHeader, {|aCampo| AllTrim(aCampo[2]) == "C6_ITEM"})

	If nPosLocal == 0 .Or. nPosItem == 0
		Return .T.
	EndIf

	For nI := 1 To Len(aCols)

		// Última posição de aCols[nI] indica se a linha foi marcada para
		// deleção (padrão MSGetDados): .T. = linha deletada na grid.
		If aCols[nI][Len(aCols[nI])] == .T.
			Loop
		EndIf

		MT410TKAcumLinha(nI, nPosLocal, nPosItem, aPendentes)

	Next nI

	If Len(aPendentes) > 0
		lRet := MT410TKAssinaLote(aPendentes)
	EndIf

Return lRet

/*/{Protheus.doc} MT410TKAcumLinha
Avalia uma linha específica da grid e, quando o Armazém foi
efetivamente alterado em relação ao valor gravado em SC6 e ainda não
foi autorizado nesta sessão de edição (aMT410TKVal), acumula a
alteração em aPendentes para validação única de Assinatura Eletrônica
ao final do laço (ver MT410TKVldGrid/MT410TKAssinaLote). Não exibe
nenhuma tela.
@type static function
@author Pablo Regis
@since 15/09/2026
@param nLinha, numeric, Número da linha corrente de aCols
@param nPosLocal, numeric, Posição de C6_LOCAL em aHeader/aCols
@param nPosItem, numeric, Posição de C6_ITEM em aHeader/aCols
@param aPendentes, array, "Acumulador (passado por referência); cada item adicionado no formato {cItem, cLocalAnt, cLocalNovo, cChaveLin}"
@return logical, .T. se a linha foi acumulada em aPendentes, .F. caso contrario (linha nova, sem alteração efetiva, ou já autorizada nesta sessão)
/*/
Static Function MT410TKAcumLinha(nLinha as Numeric, nPosLocal as Numeric, nPosItem as Numeric, aPendentes as Array) as Logical

	Local cItemLin   := "" as Character
	Local cLocalAnt  := "" as Character
	Local cLocalNovo := "" as Character
	Local cChaveLin  := "" as Character

	cItemLin   := AllTrim(aCols[nLinha][nPosItem])
	cLocalNovo := AllTrim(aCols[nLinha][nPosLocal])

	If Empty(cItemLin) .Or. Empty(cLocalNovo)
		Return .F.
	EndIf

	cLocalAnt := MT410TKLocalGrv(cItemLin)

	// Sem valor anterior gravado (linha nova) ou sem alteração efetiva:
	// não exige assinatura eletrônica.
	If Empty(cLocalAnt) .Or. cLocalNovo == cLocalAnt
		Return .F.
	EndIf

	cChaveLin := MT410TKChaveLin(cItemLin, cLocalNovo)

	// Já autorizado nesta sessão de edição para este item, com este mesmo
	// valor de destino: não acumula de novo nem repete o prompt.
	If AScan(aMT410TKVal, {|c| c == cChaveLin}) > 0
		Return .F.
	EndIf

	aAdd(aPendentes, {cItemLin, cLocalAnt, cLocalNovo, cChaveLin})

Return .T.

/*/{Protheus.doc} MT410TKLocalGrv
Retorna o valor de C6_LOCAL efetivamente gravado no banco (SC6) para o item
informado do pedido corrente (posicionado em SC5). Assume que SC5 está
posicionado no pedido em edição (mesmo padrão já adotado na implementação
anterior deste ponto de entrada). Se o item ainda não existir fisicamente
(linha nova), retorna vazio.
@type static function
@author Pablo Regis
@since 15/09/2026
@param cItem, character, Número do item (C6_ITEM) sendo validado
@return character, valor gravado de C6_LOCAL, ou vazio se é uma linha nova
/*/
Static Function MT410TKLocalGrv(cItem as Character) as Character

	Local cLocalGrv := "" as Character
	Local cAliasAnt := "" as Character
	Local nOrdAnt   := 0  as Numeric

	If Select("SC6") == 0 .Or. Select("SC5") == 0
		Return ""
	EndIf

	cAliasAnt := SC6->(GetArea())
	nOrdAnt   := SC6->(IndexOrd())

	SC6->(DbSetOrder(1))
	If SC6->(DbSeek(xFilial("SC6") + SC5->C5_NUM + cItem))
		If !Empty(SC6->C6_LOCAL)
			cLocalGrv := AllTrim(SC6->C6_LOCAL)
		EndIf
	EndIf

	SC6->(RestArea(cAliasAnt))

	// RestArea() restaura apenas Recno/Filtro, não a ordem de indice ativa.
	// Sem isto, o SC6 permanece na ordem 1 após esta validação, o que pode
	// interferir na forma como a rotina padrão MATA410 localiza/grava os
	// demais itens do grid após este Ponto de Entrada retornar.
	If nOrdAnt > 0
		SC6->(DbSetOrder(nOrdAnt))
	EndIf

Return cLocalGrv

/*/{Protheus.doc} MT410TKChaveLin
Monta a chave de controle (pedido + item + valor de destino) usada para
identificar, dentro da sessão corrente, se a alteração do Armazém daquele
item já foi autorizada com aquele valor específico.
@type static function
@author Pablo Regis
@since 15/09/2026
@param cItem, character, Número do item (C6_ITEM)
@param cLocalNovo, character, Valor de destino do Armazém
@return character, chave de controle no formato "<C5_NUM>|<item>|<C6_LOCAL>"
/*/
Static Function MT410TKChaveLin(cItem as Character, cLocalNovo as Character) as Character

	Local cNumPed := "" as Character

	If Select("SC5") > 0
		cNumPed := AllTrim(SC5->C5_NUM)
	EndIf

Return cNumPed + "|" + cItem + "|" + cLocalNovo

/*/{Protheus.doc} MT410TKAssinaLote
Exibe uma ÚNICA tela de Assinatura Eletrônica (Justificativa + Senha de
login + Chave de autorização), listando todos os itens pendentes (todos
os itens do pedido que tiveram o Armazém alterado), exigindo a senha do
próprio usuário logado uma única vez antes de liberar a gravação de
todos eles. Quando confirmado, grava um registro de auditoria por item
pendente (uma linha por item na tabela ZTL) e marca todos como
autorizados na sessão corrente (aMT410TKVal), numa única leva. Delega o
fluxo completo (tela, validações e gravação do log de auditoria na
tabela ZTL) para a classe genérica ZTLAssinaEletronica (ver
ZTLU002.tlpp), que reaproveita o mesmo padrão já usado por este PE e por
CICOMR01.tlpp.
@type static function
@author Pablo Regis
@since 15/09/2026
@param aPendentes, array, "Itens pendentes de confirmação, cada item {cItem, cLocalAnt, cLocalNovo, cChaveLin}"
@return logical, .T. se a senha, chave e justificativa foram confirmadas para todos os itens pendentes
@see ZTLAssinaEletronica
/*/
Static Function MT410TKAssinaLote(aPendentes as Array) as Logical

	Local oAssEle   := Nil as Object
	Local nI        := 0   as Numeric
	Local cChavePed := ""  as Character
	Local lRet      := .F. as Logical

	cChavePed := xFilial("SC6") + SC5->C5_NUM

	oAssEle := ZTLAssinaEletronica():New("MT410TOK", "SC6", cChavePed)
	oAssEle:SetTitulo("Assinatura Eletrônica - Alteração de Armazém")
	oAssEle:SetParamChave("FS_MT410TK", "123456")

	For nI := 1 To Len(aPendentes)
		oAssEle:AddAlteracao("C6_LOCAL", aPendentes[nI][2], aPendentes[nI][3], ;
			"Item " + aPendentes[nI][1], xFilial("SC6") + SC5->C5_NUM + aPendentes[nI][1])
	Next nI

	lRet := oAssEle:Confirma()

	If lRet
		For nI := 1 To Len(aPendentes)
			aAdd(aMT410TKVal, aPendentes[nI][4])
		Next nI
	EndIf

Return lRet
