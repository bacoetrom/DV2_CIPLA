#include "tlpp-core.th"
#INCLUDE 'rwmake.ch'
#INCLUDE 'topconn.ch'
#INCLUDE "TBICONN.CH"
#DEFINE CRLF Chr(13)+Chr(10)

/*/{Protheus.doc} ZTLAssinaEletronica
Classe genérica de Assinatura Eletrônica (Justificativa + Senha de login
+ Chave de autorização) para confirmar a alteração de campos sensíveis de
qualquer tabela/rotina, com gravação automática do log de auditoria no
motor genérico ZTL (U_ZTLGravaLog, ver ZTLU001.tlpp).
@type class
@version 1.0
@author Pablo Regis
@since 16/09/2026
/*/
Class ZTLAssinaEletronica

    Private Data cRotina        as Character
    Private Data cTabela        as Character
    Private Data cChaveReg      as Character
    Private Data cTitulo        as Character
    Private Data cParamChave    as Character
    Private Data cChaveDefault  as Character
    Private Data aAlteracoes    as Array
    Private Data cJustificativa as Character

    Public Method New(cRotina as Character, cTabela as Character, cChaveReg as Character) as Object
    Public Method SetTitulo(cTitulo as Character) as Object
    Public Method SetParamChave(cParam as Character, cChaveDefault as Character) as Object
    Public Method AddAlteracao(cCampo as Character, xValorAnt, xValorNovo, cItemLabel as Character, cChaveItem as Character) as Object
    Public Method SetAlteracoes(aAlteracoes as Array) as Object
    Public Method Confirma() as Logical
    Public Method GetJustificativa() as Character

    Private Method MontaMsgAlteracoes() as Character
    Private Method TituloCampo(cCampo as Character) as Character
    Private Method DescValor(cCampo as Character, xValor) as Character
    Private Method ValorParaChar(xValor) as Character
    Private Method ValidaSenha(cSenha as Character) as Logical
    Private Method ValidaChave(cChave as Character) as Logical
    // Publicos: acionados pela Static Function de callback do BMPBUTTON de
    // confirmação (fConfirmaZTLAssEle), fora do escopo da classe, no mesmo
    // padrão de fConfirmaCICO() usado como base em CICOMR01.tlpp
    Public Method ValidaCampos(cSenha as Character, cChave as Character, cJustif as Character) as Logical
    Public Method FechaSeValido(oDlg as Object, lValido as Logical) as Logical
    Private Method GravaLog() as Logical

EndClass

/*/{Protheus.doc} New
Construtor. Recebe os dados mínimos exigidos por U_ZTLGravaLog para
identificar a origem do registro de auditoria.
@type method
@author Pablo Regis
@since 16/09/2026
@param cRotina, character, "Rotina/função de origem (ex.: CICOMR01, MT410TOK)"
@param cTabela, character, "Alias da tabela afetada (ex.: SA2, SC6)"
@param cChaveReg, character, "Chave do registro afetado, já concatenada pelo chamador (ex.: SA2->A2_FILIAL+A2_COD+A2_LOJA)"
@return object, "instância da classe (permite chamadas encadeadas)"
/*/
Method New(cRotina as Character, cTabela as Character, cChaveReg as Character) as Object Class ZTLAssinaEletronica

    ::cRotina        := AllTrim(cRotina)
    ::cTabela        := AllTrim(cTabela)
    ::cChaveReg      := cChaveReg
    ::cTitulo        := "Assinatura Eletrônica"
    ::cParamChave    := "FS_" + Left(AllTrim(cRotina), 7)
    ::cChaveDefault  := "123456"
    ::aAlteracoes    := {}
    ::cJustificativa := ""

Return Self

/*/{Protheus.doc} SetTitulo
Define o título exibido na janela de confirmação. Quando não chamado,
usa o título padrão "Assinatura Eletrônica".
@type method
@author Pablo Regis
@since 16/09/2026
@param cTitulo, character, "Título da janela de confirmação"
@return object, "instância da classe (permite chamadas encadeadas)"
/*/
Method SetTitulo(cTitulo as Character) as Object Class ZTLAssinaEletronica

    ::cTitulo := AllTrim(cTitulo)

Return Self

/*/{Protheus.doc} SetParamChave
Define o parâmetro de sistema (SuperGetMv) usado como "Chave de
autorização" e seu valor default, no mesmo padrão já usado por
CICOMR01 (FS_CICOMR01) e MT410TOK (FS_MT410TK). Quando não chamado,
usa "FS_" + os 7 primeiros caracteres da rotina informada no
construtor, com default "123456" (limite de 10 caracteres do nome do
parâmetro no dicionário SX6).
@type method
@author Pablo Regis
@since 16/09/2026
@param cParam, character, "Nome do parâmetro de sistema (máximo 10 caracteres)"
@param cChaveDefault, character, "Valor default da chave quando o parâmetro não estiver cadastrado; se vazio, mantém o default corrente"
@return object, "instância da classe (permite chamadas encadeadas)"
/*/
Method SetParamChave(cParam as Character, cChaveDefault as Character) as Object Class ZTLAssinaEletronica

    ::cParamChave := AllTrim(cParam)

    If !Empty(cChaveDefault)
        ::cChaveDefault := cChaveDefault
    EndIf

Return Self

/*/{Protheus.doc} AddAlteracao
Adiciona uma alteração de campo sensível à lista que será exibida e
confirmada em Confirma(). Pode ser chamado várias vezes, uma por
campo alterado, cobrindo o caso do CICOMR01 (N campos alterados no
mesmo registro, confirmados numa única tela) e também o caso de N
registros físicos distintos alterados numa única confirmação (ex.:
MT410TOK validando vários itens do pedido de uma só vez), através dos
parâmetros opcionais cItemLabel/cChaveItem.
@type method
@author Pablo Regis
@since 16/09/2026
@param cCampo, character, "Nome do campo alterado (ex.: 'A2_MSBLQL')"
@param xValorAnt, variant, "Valor anterior do campo"
@param xValorNovo, variant, "Valor novo do campo"
@param cItemLabel, character, "Identificação opcional do registro/item (ex.: 'Item 0001'), exibida como prefixo na tela e no log de INFO quando uma mesma confirmação reune alterações de mais de um registro físico; vazio (default) quando a confirmação trata um único registro, mantendo o comportamento clássico de CICOMR01/A010TOK"
@param cChaveItem, character, "Chave específica deste registro para gravação no log de auditoria (ZTL_CHAVE), usada no lugar da chave informada no construtor; vazio (default) usa a chave do construtor (::cChaveReg), mantendo o comportamento clássico de CICOMR01/A010TOK onde todas as alterações pertencem ao mesmo registro"
@return object, "instância da classe (permite chamadas encadeadas)"
/*/
Method AddAlteracao(cCampo as Character, xValorAnt, xValorNovo, cItemLabel as Character, cChaveItem as Character) as Object Class ZTLAssinaEletronica

    aAdd(::aAlteracoes, {AllTrim(cCampo), xValorAnt, xValorNovo, AllTrim(cItemLabel), AllTrim(cChaveItem)})

Return Self

/*/{Protheus.doc} SetAlteracoes
Substitui de uma única vez toda a lista de alterações, no mesmo
formato de array recebido hoje pelo parâmetro aAlteracoes de
U_CICOMR01 (cada item {cCampo, cValorAnt, cValorNovo}).
@type method
@author Pablo Regis
@since 16/09/2026
@param aAlteracoes, array, "Array de alterações {cCampo, xValorAnt, xValorNovo}"
@return object, "instância da classe (permite chamadas encadeadas)"
/*/
Method SetAlteracoes(aAlteracoes as Array) as Object Class ZTLAssinaEletronica

    ::aAlteracoes := aAlteracoes

Return Self

/*/{Protheus.doc} Confirma
Exibe a janela única de Assinatura Eletrônica (lista de alterações,
Justificativa, Senha de login e Chave de autorização), valida os
dados informados e, quando confirmados, grava um registro de
auditoria por campo alterado via U_ZTLGravaLog. Quando não há
nenhuma alteração adicionada (AddAlteracao/SetAlteracoes), retorna
.T. imediatamente sem exibir tela, no mesmo comportamento do
CICOMR01. Cabe ao chamador decidir SE deve chamar Confirma() (ex.:
apenas quando ALTERA .And. Len(aAlteracoes) > 0), assim como o
próprio CICOMR01 e A010TOK já fazem.
@type method
@author Pablo Regis
@since 16/09/2026
@return logical, ".T. se não havia alteração a confirmar, ou se a Senha/Chave/Justificativa foram validadas e o log foi gravado com sucesso; .F. se o usuário cancelou, informou dados inválidos, ou a gravação do log falhou"
/*/
Method Confirma() as Logical Class ZTLAssinaEletronica

    Local cNomUsr    := AllTrim(UsrRetName(RetCodUsr())) as Character
    Local cMsgAlt    := ""                               as Character
    Local cTituloDlg := ::cTitulo                        as Character
    Local cRegistro  := ::cTabela + " - " + ::cChaveReg  as Character
    Local lRet       := .T.                              as Logical

    Private _oDlgAssEle      := Nil          as Object
    Private _oSelfAssEle     := Nil          as Object
    Private _lOpAssEle       := .F.          as Logical
    Private _cSenhaAssEle    := Space(40)    as Character
    Private _cChaveAssEle    := Space(40)    as Character
    Private _cJustifAssEle   := Space(200)   as Character
    Private _cListaAltAssEle := Space(200)   as Character

    If Len(::aAlteracoes) == 0
        Return .T.
    EndIf

    ProcLogIni({}, ::cRotina)
    ProcLogAtu("INICIO")

    cMsgAlt := ::MontaMsgAlteracoes()
    _cListaAltAssEle := cMsgAlt
    _oSelfAssEle     := Self

    ProcLogAtu("MENSAGEM", "INFO", "Tentativa de alteração de campos sensíveis via Assinatura Eletrônica" + CRLF + ;
        "Rotina: " + ::cRotina + CRLF + ;
        "Tabela/Chave: " + ::cTabela + " / " + ::cChaveReg + CRLF + ;
        cMsgAlt + ;
        "Data/Hora: " + DtoC(Date()) + " " + Time() + CRLF + ;
        "Usuário Logado: " + cNomUsr)

    // Diálogo montado com os mesmos comandos clássicos (@ .. DIALOG / @ .. GET /
    // BMPBUTTON / BUTTON / ACTIVATE DIALOG) usados como base em CICOMR01.tlpp.
    // O GET clássico exige memvar (Private/Public/Local) ligada por nome, por
    // isso os campos de tela usam as Privates acima (não ::atributo). Pelo
    // mesmo motivo, a ação do BMPBUTTON de confirmação delega para a Static
    // Function fConfirmaZTLAssEle(), no mesmo padrão do fConfirmaCICO() do
    // CICOMR01, que aciona a instância guardada em _oSelfAssEle
    @ 00,0 TO 470,350 DIALOG _oDlgAssEle TITLE cTituloDlg
        @ 08,02 SAY "Registro: "
        @ 08,35 SAY cRegistro
        @ 18,02 SAY "Alterações (campo: valor atual -> valor novo):"
        @ 24,02 GET _cListaAltAssEle MEMO SIZE 150,40 WHEN .F.
        @ 90,02 SAY "Justificativa da alteração (obrigatória):"
        @ 100,02 GET _cJustifAssEle MEMO SIZE 150,50
        @ 175,02 SAY "Redigite sua senha de login (" + cNomUsr + ") para confirmar:"
        @ 185,02 SAY "Senha: "
        @ 185,45 GET _cSenhaAssEle PICTURE "@S40" VALID .T. PASSWORD Object oSenhaAssEle
        @ 200,02 SAY "Chave: "
        @ 200,45 GET _cChaveAssEle PICTURE "@S40" VALID .T. PASSWORD Object oChaveAssEle
        @ 220,060 BMPBUTTON TYPE 1 ACTION fConfirmaZTLAssEle()
        @ 220,090 BUTTON "Auditoria" SIZE 35,11 ACTION PROCLOGVIEW()
    ACTIVATE DIALOG _oDlgAssEle CENTERED

    If !_lOpAssEle
        MsgStop("Operação cancelada, ou Senha/Chave/Justificativa inválidas. As alterações não serão gravadas.", "Cancelamento")
        ProcLogAtu("MENSAGEM", "FALHA", "Operação cancelada ou dados inválidos informados pelo usuário " + cNomUsr + ". Alterações não efetivadas.")
        ProcLogAtu("FIM")
        Return .F.
    EndIf

    ::cJustificativa := AllTrim(_cJustifAssEle)

    lRet := ::GravaLog()

    If lRet
        MsgInfo("Senha validada com sucesso. Alterações confirmadas.", "Autenticação")
        ProcLogAtu("MENSAGEM", "SUCESSO", "Senha validada. Alterações efetivadas: " + CRLF + cMsgAlt)
    Else
        MsgStop("Falha ao gravar o log de auditoria de uma ou mais alterações.", "Auditoria")
        ProcLogAtu("MENSAGEM", "FALHA", "Falha ao gravar log de auditoria via ZTLGravaLog.")
    EndIf

    ProcLogAtu("FIM")

Return lRet

/*/{Protheus.doc} GetJustificativa
Retorna a justificativa informada pelo usuário na última chamada de
Confirma() bem sucedida.
@type method
@author Pablo Regis
@since 16/09/2026
@return character, "Justificativa informada, ou vazio se Confirma() ainda não foi chamado/confirmado"
/*/
Method GetJustificativa() as Character Class ZTLAssinaEletronica
Return ::cJustificativa

/*/{Protheus.doc} MontaMsgAlteracoes
Monta a mensagem consolidada "campo (título): de -> para" de todas as
alterações adicionadas, exibida na tela de confirmação e no log de
INFO, no mesmo formato hoje usado pelo CICOMR01.
@type method
@author Pablo Regis
@since 16/09/2026
@return character, "Mensagem consolidada, uma linha por alteração"
/*/
Method MontaMsgAlteracoes() as Character Class ZTLAssinaEletronica

    Local cMsg   := "" as Character
    Local cLabel := "" as Character
    Local nI     := 0  as Numeric

    For nI := 1 To Len(::aAlteracoes)

        cLabel := ""
        If Len(::aAlteracoes[nI]) >= 4 .And. !Empty(::aAlteracoes[nI][4])
            cLabel := AllTrim(::aAlteracoes[nI][4]) + " - "
        EndIf

        cMsg += cLabel + ::TituloCampo(::aAlteracoes[nI][1]) + " (" + ::aAlteracoes[nI][1] + "): " + ;
            ::DescValor(::aAlteracoes[nI][1], ::aAlteracoes[nI][2]) + " -> " + ;
            ::DescValor(::aAlteracoes[nI][1], ::aAlteracoes[nI][3]) + CRLF
    Next nI

Return cMsg

/*/{Protheus.doc} TituloCampo
Retorna o título do campo diretamente do dicionário de dados (SX3),
sem mapeamento fixo no código. Equivalente a fTituloCampo do
CICOMR01.tlpp.
@type method
@author Pablo Regis
@since 16/09/2026
@param cCampo, character, "Nome do campo (ex.: 'A2_MSBLQL')"
@return character, "Título do campo (X3_TITULO); quando não encontrado no dicionário, retorna o próprio nome do campo"
/*/
Method TituloCampo(cCampo as Character) as Character Class ZTLAssinaEletronica

    Local cAliasAnt := Alias()          as Character
    Local cTitulo   := AllTrim(cCampo)  as Character

    dbSelectArea("SX3")
    dbSetOrder(2)
    If dbSeek(AllTrim(cCampo))
        cTitulo := AllTrim(X3Titulo())
    EndIf

    If !Empty(cAliasAnt)
        dbSelectArea(cAliasAnt)
    EndIf

Return cTitulo

/*/{Protheus.doc} DescValor
Retorna a descrição "amigável" de um valor de campo, via X3Combo()
quando aplicável, para uso exclusivo na mensagem exibida ao usuário
(tela/log de INFO). Equivalente a fDescValor do CICOMR01.tlpp.
@type method
@author Pablo Regis
@since 16/09/2026
@param cCampo, character, "Nome do campo"
@param xValor, variant, "Conteúdo do campo"
@return character, "Descrição amigável do valor"
/*/
Method DescValor(cCampo as Character, xValor) as Character Class ZTLAssinaEletronica

    Local cDesc := "" as Character

    If ValType(xValor) == "C"
        cDesc := AllTrim(X3Combo(cCampo, xValor))
        If Empty(cDesc)
            cDesc := AllTrim(xValor)
        EndIf
    Else
        cDesc := ::ValorParaChar(xValor)
        
    EndIf

Return cDesc

/*/{Protheus.doc} ValorParaChar
Converte um valor de qualquer tipo suportado (C/N/D/L/U) para
Character bruto (sem consulta a X3Combo), para uso exclusivo na
gravação do log de auditoria (U_ZTLGravaLog exige Character), onde o
valor persistido deve ser o mesmo valor gravado no banco, e não a
descrição amigável exibida em tela.
@type method
@author Pablo Regis
@since 16/09/2026
@param xValor, variant, "Valor a converter"
@return character, "Valor convertido para Character"
/*/
Method ValorParaChar(xValor) as Character Class ZTLAssinaEletronica

    Local cRet := "" as Character

    If ValType(xValor) == "C" .Or. ValType(xValor) == "M"
        cRet := AllTrim(xValor)
    ElseIf ValType(xValor) == "U"
        cRet := ""
    ElseIf ValType(xValor) == "N"
        cRet := AllTrim(Str(xValor))
    ElseIf ValType(xValor) == "D"
        cRet := DToC(xValor)
    ElseIf ValType(xValor) == "L"
        If xValor
            cRet := "Sim"
        Else
            cRet := "Não"
        EndIf
    Else
        cRet := cValToChar(xValor)
    EndIf

Return cRet

/*/{Protheus.doc} ValidaSenha
Valida a senha digitada contra a senha do próprio usuário logado,
usando exatamente o mesmo critério já em produção em CICOMR01.tlpp e
MT410TOK.tlpp: PswOrder(2) + PswSeek(cNomUsr, .T.), comparando o
valor bruto retornado por PswRet() e, como alternativa, PswName().
@type method
@author Pablo Regis
@since 16/09/2026
@obs Mesmo critério já usado em produção pelos fontes de referência
(não alterados). PswSeek()/PswName() deixaram de validar senha de
forma confiável a partir do Protheus 11 (falha de segurança corrigida
pela TOTVS); mantido aqui apenas para preservar o mesmo padrão já
adotado nos fontes modelo.
@param cSenha, character, "Senha digitada pelo usuário a validar"
@return logical, ".T. se a senha do usuário logado está correta"
/*/
Method ValidaSenha(cSenha as Character) as Logical Class ZTLAssinaEletronica

    Local cNomUsr := AllTrim(UsrRetName(RetCodUsr())) as Character
    Local aRetPsw  as Array
    Local lRet    := .F. as Logical

    PswOrder(2)
    If PswSeek(cNomUsr, .T.)
        aRetPsw := PswRet()
        If AllTrim(aRetPsw[1][3]) == AllTrim(cSenha)
            lRet := .T.
        ElseIf PswName(AllTrim(cSenha))
            lRet := .T.
        EndIf
    EndIf

Return lRet

/*/{Protheus.doc} ValidaChave
Valida a Chave de autorização digitada contra o parâmetro de sistema
configurado via SetParamChave() (ou o default calculado no
construtor), no mesmo padrão do parâmetro FS_CICOMR01/FS_MT410TK.
@type method
@author Pablo Regis
@since 16/09/2026
@param cChave, character, "Chave digitada pelo usuário"
@return logical, ".T. se a chave digitada confere com o parâmetro de sistema"
/*/
Method ValidaChave(cChave as Character) as Logical Class ZTLAssinaEletronica

    Local cChaveOk := SuperGetMv(::cParamChave, .F., ::cChaveDefault) as Character

Return cChaveOk == AllTrim(cChave)

/*/{Protheus.doc} ValidaCampos
Valida, nesta ordem, a obrigatoriedade da Justificativa, a Senha e a
Chave de autorização digitadas no diálogo de confirmação, exibindo o
respectivo MsgAlert quando inválido. Chamada pelo botão de confirmar
do diálogo montado em Confirma().
@type method
@author Pablo Regis
@since 16/09/2026
@param cSenha, character, "Senha digitada"
@param cChave, character, "Chave digitada"
@param cJustif, character, "Justificativa digitada"
@return logical, ".T. se Justificativa, Senha e Chave são todas válidas"
/*/
Method ValidaCampos(cSenha as Character, cChave as Character, cJustif as Character) as Logical Class ZTLAssinaEletronica

    If Empty(AllTrim(cJustif))
        MsgAlert("Informe a justificativa da alteração antes de confirmar.", "Atenção")
        Return .F.
    EndIf

    If !::ValidaSenha(cSenha)
        MsgAlert("Senha inválida.", "Autenticação")
        Return .F.
    EndIf

    If !::ValidaChave(cChave)
        MsgAlert("Chave de autorização inválida.", "Autenticação")
        Return .F.
    EndIf

Return .T.

/*/{Protheus.doc} FechaSeValido
Fecha o diálogo de confirmação somente quando a validação dos campos
foi bem sucedida, mantendo a tela aberta para o usuário corrigir os
dados em caso de falha (mesmo comportamento do CICOMR01/MT410TOK).
@type method
@author Pablo Regis
@since 16/09/2026
@param oDlg, object, "Diálogo de confirmação (objeto clássico retornado por @ .. DIALOG, igual ao _oTela do CICOMR01)"
@param lValido, logical, ".T. fecha o diálogo"
@return logical, "o próprio valor de lValido recebido"
/*/
Method FechaSeValido(oDlg as Object, lValido as Logical) as Logical Class ZTLAssinaEletronica

    If lValido
        Close(oDlg)
    EndIf

Return lValido

/*/{Protheus.doc} GravaLog
Percorre todas as alterações adicionadas e grava um registro de
auditoria por campo no motor genérico ZTL via U_ZTLGravaLog (ver
ZTLU001.tlpp), usando a Justificativa confirmada em Confirma(). Quando
uma alteração específica informou cChaveItem (ver AddAlteracao), usa
essa chave no lugar de ::cChaveReg, permitindo que uma única
confirmação grave um registro de log por item/registro físico
efetivamente alterado (ex.: MT410TOK).
@type method
@author Pablo Regis
@since 16/09/2026
@return logical, ".T. se todos os registros foram gravados com sucesso"
/*/
Method GravaLog() as Logical Class ZTLAssinaEletronica

    Local nI        := 0  as Numeric
    Local lRet      := .T. as Logical
    Local cChaveLog := "" as Character

    For nI := 1 To Len(::aAlteracoes)

        cChaveLog := ::cChaveReg
        If Len(::aAlteracoes[nI]) >= 5 .And. !Empty(::aAlteracoes[nI][5])
            cChaveLog := ::aAlteracoes[nI][5]
        EndIf

        If !U_ZTLGravaLog( ::cRotina, ::cTabela, cChaveLog, ::aAlteracoes[nI][1], ;
                ::DescValor(::aAlteracoes[nI][1], ::aAlteracoes[nI][2]), ;
                ::DescValor(::aAlteracoes[nI][1], ::aAlteracoes[nI][3]), ;
                ::cJustificativa )
            lRet := .F.
        EndIf
    Next nI

Return lRet

/*/{Protheus.doc} fConfirmaZTLAssEle
Valida a obrigatoriedade da Justificativa, a Senha de login e a Chave
de autorização antes de permitir o fechamento do diálogo clássico de
Assinatura Eletrônica montado em ZTLAssinaEletronica:Confirma().
Equivalente ao fConfirmaCICO() do CICOMR01.tlpp: existe como Static
Function (fora da classe) porque o BMPBUTTON clássico só aceita uma
chamada de função simples em ACTION, e aciona a instância da classe
guardada na Private _oSelfAssEle.
@type function
@author Pablo Regis
@since 16/09/2026
@return logical, ".T. se os dados informados são válidos e o diálogo foi fechado"
/*/
Static Function fConfirmaZTLAssEle() as Logical

    _lOpAssEle := _oSelfAssEle:ValidaCampos(_cSenhaAssEle, _cChaveAssEle, _cJustifAssEle)
    _oSelfAssEle:FechaSeValido(_oDlgAssEle, _lOpAssEle)

Return _lOpAssEle
