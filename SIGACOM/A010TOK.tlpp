#include "tlpp-core.th"
#include "totvs.ch"

#DEFINE CRLF Chr(13)+Chr(10)

/*/{Protheus.doc} A010TOK
Ponto de Entrada da rotina MATA010 (Cadastro de Produtos).
Executado dentro da funcao A010TudoOk(), no inicio das validacoes,
logo apos a confirmacao de inclusao/alteracao e ANTES da gravacao
do registro no SB1.

Verifica se o campo B1_TIPO foi alterado. Se sim, exige uma
justificativa do usuario (via U_ZTLGetJustif) antes de permitir a
gravacao, e registra o evento no motor generico de auditoria ZTL
(via U_ZTLGravaLog).
@type user function
@author Pablo Regis
@since 27/08/2026
@return logical, ".T. permite a gravacao / .F. bloqueia por falta de justificativa"
@table SB1
@see ZTLU001
/*/
User Function A010TOK() as Logical

    Local lRet       := .T. as Logical
    Local cTipoAnt   := ""  as Character
    Local cTipoNovo  := ""  as Character
    Local cJustif    := ""  as Character
    Local cChaveProd := ""  as Character

    // ALTERA e INCLUI sao variaveis publicas/privadas padrao da rotina MATA010
    // que indicam a operacao corrente. So valida se for ALTERACAO de um
    // registro ja existente (em inclusao nao ha "valor anterior" a comparar).
    If ALTERA .And. !Empty(SB1->B1_TIPO)

        cTipoAnt  := SB1->B1_TIPO   // valor gravado no banco (ainda nao sobrescrito)
        cTipoNovo := M->B1_TIPO     // valor digitado pelo usuario na tela

        If AllTrim(cTipoAnt) <> AllTrim(cTipoNovo)

            cJustif := U_ZTLGetJustif( "Alteracao do Tipo do Produto",;
                        "Produto : " + SB1->B1_COD + " - " + SB1->B1_DESC + CRLF +;
                        "Tipo atual : " + cTipoAnt + "   ->   Novo tipo : " + cTipoNovo )

            If Empty(cJustif)
                MsgAlert( "A alteracao do campo Tipo do Produto (B1_TIPO) nao e permitida sem justificativa.", "Atencao" )
                lRet := .F.
            Else
                cChaveProd := SB1->B1_FILIAL + SB1->B1_COD
                U_ZTLGravaLog( "A010TOK", "SB1", cChaveProd, "B1_TIPO", cTipoAnt, cTipoNovo, cJustif )
            EndIf

        EndIf

    EndIf

Return lRet
