#include "tlpp-core.th"
#include "totvs.ch"

#DEFINE CRLF Chr(13)+Chr(10)

//-------------------------------------------------------------------
// ZTLU001 - Motor Generico de Auditoria (tabela ZTL)
//
// Biblioteca reaproveitavel por qualquer rotina/entry point do
// sistema que precise registrar a alteracao de um campo sensivel
// mediante justificativa obrigatoria do usuario. Centraliza a
// gravacao do log (ZTLGravaLog) e o dialogo de captura da
// justificativa (ZTLGetJustif), usados hoje por A010TOK (MATA010)
// e CICOMR01 (SA2).
//-------------------------------------------------------------------

/*/{Protheus.doc} ZTLGravaLog
Grava um registro generico de auditoria na tabela ZTL.
@type user function
@version 1.0
@author Pablo Regis
@since 27/08/2026
@param cRotina, character, "Rotina/funcao de origem (ex.: CICOMR01, A010TOK)"
@param cTabela, character, "Alias da tabela afetada (ex.: SA2, SB1)"
@param cChave, character, "Chave do registro afetado"
@param cCampo, character, "Nome do campo alterado"
@param xValorAnt, variant, "Valor anterior (character, numeric, date ou logical - convertido automaticamente para texto antes de gravar)"
@param xValorNov, variant, "Valor novo (character, numeric, date ou logical - convertido automaticamente para texto antes de gravar)"
@param cJustif, character, "Justificativa informada pelo usuario"
@return logical, "retorna .T. se o registro foi gravado com sucesso"
@table ZTL
/*/
User Function ZTLGravaLog(cRotina as Character, cTabela as Character, cChave as Character, cCampo as Character, xValorAnt as Variant, xValorNov as Variant, cJustif as Character) as Logical

    Local aArea         := GetArea()               as Array
    Local cFilAux       := xFilial("ZTL")          as Character
    Local cNumSeq       := ""                      as Character
    Local lRet          := .F.                     as Logical
    Local cValorAntFmt  := fValorToChar(xValorAnt) as Character
    Local cValorNovFmt  := fValorToChar(xValorNov) as Character

    If Select("ZTL") == 0
        dbUseArea(.T., "TOPCONN", RetSqlName("ZTL"), "ZTL", .T., .F.)
    EndIf

    If Select("ZTL") == 0
        RestArea(aArea)
        Return .F.
    EndIf

    DbSelectArea("ZTL")

    Try
        cNumSeq := GetSxeNum("ZTL", "ZTL_SEQ")

        RecLock("ZTL", .T.)
            ZTL->ZTL_FILIAL := cFilAux
            ZTL->ZTL_SEQ    := cNumSeq
            ZTL->ZTL_ROTINA := cRotina
            ZTL->ZTL_TABELA := cTabela
            ZTL->ZTL_CHAVE  := cChave
            ZTL->ZTL_CAMPO  := cCampo
            ZTL->ZTL_VALANT := cValorAntFmt
            ZTL->ZTL_VALNOV := cValorNovFmt
            ZTL->ZTL_JUSTIF := cJustif
            ZTL->ZTL_USER   := Alltrim(UsrRetName(RetCodUsr()))
            ZTL->ZTL_DATA   := Date()
            ZTL->ZTL_HORA   := Time()
        MsUnlock()

        ConfirmSX8()
        lRet := .T.
    Catch oError
        RollbackSX8()
        FWLogMsg("ERROR", , "ZTLGravaLog", cRotina, , "01", oError:Description, 0, 0, {})
        lRet := .F.
    EndTry

    RestArea(aArea)

Return lRet

/*/{Protheus.doc} ZTLGetJustif
Exibe dialogo modal generico solicitando justificativa obrigatoria
para uma alteracao sensivel.
@type user function
@version 1.0
@author Pablo Regis
@since 27/08/2026
@param cTitulo, character, "Titulo da janela"
@param cMsg, character, "Mensagem/contexto exibido acima do campo"
@return character, "Texto digitado, ou vazio se cancelado/nao preenchido"
/*/
User Function ZTLGetJustif(cTitulo as Character, cMsg as Character) as Character

    Local oDlg   as Object
    Local oMemo  as Object
    Local cTexto := Space(200) as Character
    Local lOk    := .F.        as Logical
    Local cRet   := ""         as Character

    DEFINE MSDIALOG oDlg TITLE cTitulo FROM 0,0 TO 350,450 PIXEL
        @ 10,10 SAY cMsg SIZE 220,30 OF oDlg PIXEL
        @ 25,10 SAY "Justificativa (obrigatoria):" SIZE 200,20 OF oDlg PIXEL
        @ 45,10 GET oMemo VAR cTexto MEMO SIZE 210,90 OF oDlg PIXEL

        DEFINE SBUTTON FROM 140,90  TYPE 1 ACTION ( lOk := !Empty(AllTrim(cTexto)), oDlg:End() ) ENABLE OF oDlg
        DEFINE SBUTTON FROM 140,140 TYPE 2 ACTION ( cTexto := "", oDlg:End() ) ENABLE OF oDlg
    ACTIVATE MSDIALOG oDlg CENTERED

    If lOk
        cRet := AllTrim(cTexto)
    Else
        cRet := ""
    EndIf

Return cRet

/*/{Protheus.doc} fValorToChar
Converte um valor de qualquer tipo suportado (character, numeric, date, logical)
para sua representacao em texto, para gravacao nos campos ZTL_VALANT/ZTL_VALNOV.
@type function
@author Pablo Regis
@since 10/09/2026
@param xValor, variant, "Valor a ser convertido (character, numeric, date, logical ou nil)"
@return character, "Representacao textual do valor: o proprio texto (character/memo), numero formatado (numeric), data no formato dd/mm/aaaa (date), 'Sim'/'Nao' (logical), vazio (nil) ou cValToChar() como fallback para outros tipos"
/*/
Static Function fValorToChar(xValor as Variant) as Character

    Local cRet := "" as Character

    If ValType(xValor) == "U"
        cRet := ""
    ElseIf ValType(xValor) == "C" .Or. ValType(xValor) == "M"
        cRet := xValor
    ElseIf ValType(xValor) == "N"
        cRet := AllTrim(Str(xValor))
    ElseIf ValType(xValor) == "D"
        cRet := DToC(xValor)
    ElseIf ValType(xValor) == "L"
        If xValor
            cRet := "Sim"
        Else
            cRet := "Nao"
        EndIf
    Else
        cRet := cValToChar(xValor)
    EndIf

Return cRet
