#include "tlpp-core.th"
#include "totvs.ch"

#DEFINE CRLF Chr(13)+Chr(10)

//-------------------------------------------------------------------
// ZTLU001 - Motor Genérico de Auditoria (tabela ZTL)
//
// Biblioteca reaproveitável por qualquer rotina/entry point do
// sistema que precise registrar a alteração de um campo sensível
// mediante justificativa obrigatória do usuário. Centraliza a
// gravação do log (ZTLGravaLog) e o diálogo de captura da
// justificativa (ZTLGetJustif), usados hoje por A010TOK (MATA010)
// e CICOMR01 (SA2).
//-------------------------------------------------------------------

/*/{Protheus.doc} ZTLGravaLog
Grava um registro genérico de auditoria na tabela ZTL.
@type user function
@version 1.0
@author Pablo Regis
@since 27/08/2026
@param cRotina, character, "Rotina/função de origem (ex.: CICOMR01, A010TOK)"
@param cTabela, character, "Alias da tabela afetada (ex.: SA2, SB1)"
@param cChave, character, "Chave do registro afetado"
@param cCampo, character, "Nome do campo alterado"
@param xValorAnt, variant, "Valor anterior (character, numeric, date ou logical - convertido automaticamente para texto antes de gravar)"
@param xValorNov, variant, "Valor novo (character, numeric, date ou logical - convertido automaticamente para texto antes de gravar)"
@param cJustif, character, "Justificativa informada pelo usuário"
@return logical, "retorna .T. se o registro foi gravado com sucesso"
@table ZTL
/*/
User Function ZTLGravaLog(cRotina as Character, cTabela as Character, cChave as Character, cCampo as Character, xValorAnt as Variant, xValorNov as Variant, cJustif as Character) as Logical

    Local aArea         := GetArea()               as Array
    Local cFilAux       := xFilial("ZTL")          as Character
    Local cNumSeq       := ""                      as Character
    Local lRet          := .F.                     as Logical
    Local cValorAntFmt  := fValorToChar(xValorAnt) as Character
    Local cValorNovFmt  := fValorToChar(xValorNov) as Character

    // If Select("ZTL") == 0
    //     dbUseArea(.T., "TOPCONN", RetSqlName("ZTL"), "ZTL", .T., .F.)
    // EndIf

    // If Select("ZTL") == 0
    //     RestArea(aArea)
    //     Return .F.
    // EndIf

    DbSelectArea("ZTL")

    Try
        DbSetOrder(1)
        cNumSeq := GetSxeNum("ZTL", "ZTL_SEQ")

        RecLock("ZTL", .T.)
            ZTL->ZTL_FILIAL := cFilAux
            ZTL->ZTL_SEQ    := Right(cNumSeq, 9)
            ZTL->ZTL_ROTINA := cRotina
            ZTL->ZTL_TABELA := cTabela
            ZTL->ZTL_CHAVE  := cChave
            ZTL->ZTL_CAMPO  := cCampo
            ZTL->ZTL_VALANT := cValorAntFmt
            ZTL->ZTL_VALNOV := cValorNovFmt
            ZTL->ZTL_JUSTIF := cJustif
            ZTL->ZTL_USER   := Alltrim(UsrRetName(RetCodUsr()))
            ZTL->ZTL_DATA   := Date()
            ZTL->ZTL_HORA   := Time()
        MsUnlock()

        ConfirmSX8()
        lRet := .T.
    Catch oError
        RollbackSX8()
        FWLogMsg("ERROR", , "ZTLGravaLog", cRotina, , "01", oError:Description, 0, 0, {})
        lRet := .F.
    EndTry

    RestArea(aArea)

Return lRet


/*/{Protheus.doc} fValorToChar
Converte um valor de qualquer tipo suportado (character, numeric, date, logical)
para sua representação em texto, para gravação nos campos ZTL_VALANT/ZTL_VALNOV.
@type function
@author Pablo Regis
@since 10/09/2026
@param xValor, variant, "Valor a ser convertido (character, numeric, date, logical ou nil)"
@return character, "Representação textual do valor: o próprio texto (character/memo), número formatado (numeric), data no formato dd/mm/aaaa (date), 'Sim'/'Não' (logical), vazio (nil) ou cValToChar() como fallback para outros tipos"
/*/
Static Function fValorToChar(xValor as Variant) as Character

    Local cRet := "" as Character

    If ValType(xValor) == "U"
        cRet := ""
    ElseIf ValType(xValor) == "C" .Or. ValType(xValor) == "M"
        cRet := xValor
    ElseIf ValType(xValor) == "N"
        cRet := AllTrim(Str(xValor))
    ElseIf ValType(xValor) == "D"
        cRet := DToC(xValor)
    ElseIf ValType(xValor) == "L"
        If xValor
            cRet := "Sim"
        Else
            cRet := "Não"
        EndIf
    Else
        cRet := cValToChar(xValor)
    EndIf

Return cRet
