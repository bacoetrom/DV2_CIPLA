#include "tlpp-core.th"
#include "totvs.ch"

/*/{Protheus.doc} ZZ3GravaLog
Grava��o de auditoria na tabela ZZ3
@type function
@version 1.0  
@author Pablo Regis
@since 9/24/2026
@param cRotina, character, rotina de origem da gravacao (ex.: MATA261)
@param cDocNum, character, numero do documento
@param cProduto, character, codigo do produto
@param nQuant, numeric, quantidade do produto
@param cArmOri, character, armazem de origem
@param cArmDes, character, armazem de destino
@param cJustificativa, character, justificativa da transferencia
@param cOrigem, character, origem da transferencia
@return logical, ".T. se o registro foi gravado com sucesso, ".F." caso contrario
/*/
User Function ZZ3GravaLog(cRotina, cDocNum, cProduto, nQuant, cArmOri, cArmDes, cJustificativa, cOrigem)
    Local aArea         := GetArea()               as Array
    Local lRet      := .T. as Logical

    Try

        DbSelectArea("ZZ3")
        DbSetOrder(1) // ZZ3_FILIAL + ZZ3_DOC + ZZ3_PRODUT

        If RecLock("ZZ3", .T.)
            ZZ3->ZZ3_FILIAL  := xFilial("ZZ3")
            ZZ3->ZZ3_DOC     := cDocNum
            ZZ3->ZZ3_PRODUT  := cProduto
            ZZ3->ZZ3_QUANT   := nQuant
            ZZ3->ZZ3_ARMORI  := cArmOri
            ZZ3->ZZ3_ARMDES  := cArmDes
            ZZ3->ZZ3_ORIGEM  := cOrigem
            ZZ3->ZZ3_JUSTIF  := AllTrim(cJustificativa)
            ZZ3->ZZ3_USUARIO := Alltrim(UsrRetName(RetCodUsr()))
            ZZ3->ZZ3_DATA    := Date()
            ZZ3->ZZ3_HORA    := Time()
            
            ZZ3->(MsUnlock())
        EndIf

    Catch oError
        RollbackSX8()
        FWLogMsg("ERROR", , "ZTLGravaLog", cRotina, , "01", oError:Description, 0, 0, {})
        lRet := .F.
    EndTry

    RestArea(aArea)

Return lRet
