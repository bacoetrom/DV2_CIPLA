#include "tlpp-core.th"
#include "totvs.ch"
#INCLUDE 'rwmake.ch'
#DEFINE CRLF Chr(13)+Chr(10)

/*/{Protheus.doc} ZZ2AssinaEletronica
Classe de Assinatura Eletrônica (Justificativa + Senha de login) para
confirmar a Assinatura Transferência entre Armazens/Depositos (MATA261), com
gravacao automatica do log de auditoria de todos os itens transferidos
(aCols) na tabela ZZ2 (U_ZZ2GravaLog, ver CI04A003.tlpp).

Diferente da ZZ1AssinaEletronica (SIGACOM/ZZ1U002.tlpp), o layout de
confirmação aqui NAO exibe lista de alteracoes de campo, pois toda
Assinatura Transferência confirmada e sempre registrada, independente de haver ou
nao alteracao de valores.

@type class
@version 1.0
@author Pablo Regis
@since 24/09/2026
/*/
Class ZZ2AssinaEletronica

    Private Data cRotina        as Character
    Private Data cDocNum        as Character
    Private Data cOrigem        as Character
    Private Data cTitulo        as Character
    Private Data aItens         as Array
    Private Data nPosProduto    as Numeric
    Private Data nPosQuant      as Numeric
    Private Data nPosArmOri     as Numeric
    Private Data nPosArmDes     as Numeric
    Private Data nPosTipo       as Numeric
    Private Data cJustificativa as Character

    Public Method New(cRotina as Character, cDocNum as Character, cOrigem as Character) as Object
    Public Method SetTitulo(cTitulo as Character) as Object
    Public Method SetPosicoesGrid(nPosProduto as Numeric, nPosQuant as Numeric, nPosArmOri as Numeric, nPosArmDes as Numeric) as Object
    Public Method SetPosicaoTipo(nPosTipo as Numeric) as Object
    Public Method SetItens(aItens as Array) as Object
    Public Method Confirma() as Logical
    Public Method GravaAutomatico(cJustificativa as Character) as Logical
    Public Method GetJustificativa() as Character

    Private Method MontaMsgItens() as Character
    Private Method ValidaSenha(cSenha as Character) as Logical
    // Publicos: acionados pela Static Function de callback do BMPBUTTON de
    // confirmação (fConfirmaZZ2AssEle), fora do escopo da classe, no mesmo
    // padrao de fConfirmaZZ1AssEle() usado como base em ZZ1U002.tlpp
    Public Method ValidaCampos(cSenha as Character, cJustif as Character) as Logical
    Public Method FechaSeValido(oDlg as Object, lValido as Logical) as Logical
    Private Method GravaLog() as Logical

EndClass

/*/{Protheus.doc} New
Construtor. Recebe os dados minimos exigidos por U_ZZ2GravaLog para
identificar a origem do registro de auditoria. As posicoes de grid
(aCols) ja iniciam com o padrao confirmado para o MATA261: Produto=1,
Quantidade=16, Armazem Origem=4, Armazem Destino=9 (ver SetPosicoesGrid
para alterar em outra rotina).
@type method
@author Pablo Regis
@since 24/09/2026
@param cRotina, character, "Rotina de origem (ex.: MATA261)"
@param cDocNum, character, "Numero do documento de Assinatura Transferência"
@param cOrigem, character, "Origem do processo: 1=Manual/Interativo, 2=Automatico"
@return object, "instancia da classe (permite chamadas encadeadas)"
/*/
Method New(cRotina as Character, cDocNum as Character, cOrigem as Character) as Object Class ZZ2AssinaEletronica

    ::cRotina        := AllTrim(cRotina)
    ::cDocNum        := AllTrim(cDocNum)
    ::cOrigem        := cOrigem
    ::cTitulo        := "Assinatura Eletrônica - Assinatura Transferência"
    ::aItens         := {}
    ::nPosProduto    := 1
    ::nPosQuant      := 16
    ::nPosArmOri     := 4
    ::nPosArmDes     := 9
    ::nPosTipo       := 0
    ::cJustificativa := ""

Return Self

/*/{Protheus.doc} SetTitulo
Define o titulo exibido na janela de confirmação. Quando nao chamado,
usa o titulo padrao "Assinatura Eletrônica - Assinatura Transferência".
@type method
@author Pablo Regis
@since 24/09/2026
@param cTitulo, character, "Titulo da janela de confirmação"
@return object, "instancia da classe (permite chamadas encadeadas)"
/*/
Method SetTitulo(cTitulo as Character) as Object Class ZZ2AssinaEletronica

    ::cTitulo := AllTrim(cTitulo)

Return Self

/*/{Protheus.doc} SetPosicoesGrid
Redefine as posicoes (indices) de Produto, Quantidade, Armazem Origem e
Armazem Destino dentro de cada linha de aCols, para o caso desta classe
ser reaproveitada em outra rotina com layout de grid diferente do
MATA261.
@type method
@author Pablo Regis
@since 24/09/2026
@param nPosProduto, numeric, "Indice do Produto em aCols[n]"
@param nPosQuant, numeric, "Indice da Quantidade em aCols[n]"
@param nPosArmOri, numeric, "Indice do Armazem de Origem em aCols[n]"
@param nPosArmDes, numeric, "Indice do Armazem de Destino em aCols[n]"
@return object, "instancia da classe (permite chamadas encadeadas)"
/*/
Method SetPosicoesGrid(nPosProduto as Numeric, nPosQuant as Numeric, nPosArmOri as Numeric, nPosArmDes as Numeric) as Object Class ZZ2AssinaEletronica

    ::nPosProduto := nPosProduto
    ::nPosQuant   := nPosQuant
    ::nPosArmOri  := nPosArmOri
    ::nPosArmDes  := nPosArmDes

Return Self

/*/{Protheus.doc} SetPosicaoTipo
Define (opcional) o indice, dentro de cada linha de aItens, da descricao
do tipo de movimento do item (ex.: LIBERACAO, REJEICAO). Quando informado
(maior que zero), a justificativa gravada na ZZ2 para o item recebe o
prefixo "[<tipo>] ", permitindo diferenciar o movimento sem alterar o
dicionario. Quando nao chamado (padrao 0), nada muda (ex.: MATA261).
@type method
@author Pablo Regis
@since 08/10/2026
@param nPosTipo, numeric, "Indice da descricao do tipo de movimento em aItens[n] (0 = nao usa)"
@return object, "instancia da classe (permite chamadas encadeadas)"
/*/
Method SetPosicaoTipo(nPosTipo as Numeric) as Object Class ZZ2AssinaEletronica

    ::nPosTipo := nPosTipo

Return Self

/*/{Protheus.doc} SetItens
Define a grid de itens da Assinatura Transferência (aCols da rotina padrao
MATA261) que serao percorridos e gravados, um a um, no log de
auditoria da ZZ2 quando a confirmação for validada.
@type method
@author Pablo Regis
@since 24/09/2026
@param aItens, array, "Array de linhas da grid (aCols), cada linha contendo ao menos as posicoes de Produto/Quantidade/Armazem Origem/Armazem Destino"
@return object, "instancia da classe (permite chamadas encadeadas)"
/*/
Method SetItens(aItens as Array) as Object Class ZZ2AssinaEletronica

    ::aItens := aItens

Return Self

/*/{Protheus.doc} Confirma
Exibe a janela de Assinatura Eletrônica (Justificativa + Senha de
login), valida os dados informados e, quando confirmados, grava um
registro de auditoria por item transferido via U_ZZ2GravaLog. Nao
exibe lista de alteracoes de campo (diferente da ZZ1AssinaEletronica),
pois toda Assinatura Transferência confirmada e sempre registrada. Quando nao ha
nenhum item em aItens (SetItens), retorna .T. imediatamente sem exibir
tela.
@type method
@author Pablo Regis
@since 24/09/2026
@return logical, ".T. se nao havia item a confirmar, ou se Senha/Justificativa foram validadas e o log foi gravado com sucesso; .F. se o usuario cancelou, informou dados inválidos, ou a gravacao do log falhou"
/*/
Method Confirma() as Logical Class ZZ2AssinaEletronica

    Local cNomUsr    := AllTrim(UsrRetName(RetCodUsr())) as Character
    Local cTituloDlg := ::cTitulo                        as Character
    Local lRet       := .T.                              as Logical

    Private _oDlgZZ2Ass    := Nil          as Object
    Private _oSelfZZ2Ass   := Nil          as Object
    Private _lOpZZ2Ass     := .F.          as Logical
    Private _cSenhaZZ2Ass  := Space(40)    as Character
    Private _cJustifZZ2Ass := Space(255)   as Character

    If Len(::aItens) == 0
        Return .T.
    EndIf

    ProcLogIni({}, ::cRotina)
    ProcLogAtu("INICIO")

    _oSelfZZ2Ass := Self

    ProcLogAtu("MENSAGEM", "INFO", "Tentativa de confirmação de Assinatura Transferência via Assinatura Eletrônica" + CRLF + ;
        "Rotina: " + ::cRotina + CRLF + ;
        "Documento: " + ::cDocNum + CRLF + ;
        ::MontaMsgItens() + ;
        "Data/Hora: " + DtoC(Date()) + " " + Time() + CRLF + ;
        "Usuario Logado: " + cNomUsr)

    // Dialogo montado com os mesmos comandos classicos (@ .. DIALOG / @ .. GET /
    // BMPBUTTON / ACTIVATE DIALOG) usados como base em ZZ1AssinaEletronica
    // (ZZ1U002.tlpp). O GET classico exige memvar (Private) ligada por nome,
    // por isso os campos de tela usam as Privates acima (nao ::atributo). Pelo
    // mesmo motivo, a acao do BMPBUTTON de confirmação delega para a Static
    // Function fConfirmaZZ2AssEle(), que aciona a instancia guardada em
    // _oSelfZZ2Ass
    @ 000,000 TO 350,350 DIALOG _oDlgZZ2Ass TITLE cTituloDlg
        @ 008,008 SAY "Documento: " + ::cDocNum
        @ 008,120 SAY "Usuario: " + cNomUsr
        @ 022,008 SAY "Justificativa da Assinatura Transferência (obrigatoria):"
        @ 032,008 GET _cJustifZZ2Ass MEMO SIZE 150,040
        @ 084,008 SAY "Redigite sua senha de login ("+cNomUsr+") para confirmar:"
        @ 094,008 SAY "Senha: "
        @ 094,045 GET _cSenhaZZ2Ass PICTURE "@S40" VALID .T. PASSWORD OBJECT oSenhaZZ2Ass
        @ 125,060 BMPBUTTON TYPE 1 ACTION fConfirmaZZ2AssEle()
        @ 125,090 BUTTON "Auditoria" SIZE 35,11 ACTION PROCLOGVIEW()
    ACTIVATE DIALOG _oDlgZZ2Ass CENTERED

    If !_lOpZZ2Ass
        MsgStop("Operacao cancelada, ou Senha/Justificativa inválidas. A Assinatura Transferência nao sera confirmada.", "Cancelamento")
        ProcLogAtu("MENSAGEM", "FALHA", "Operacao cancelada ou dados inválidos informados pelo usuario " + cNomUsr + ". Assinatura Transferência nao efetivada.")
        ProcLogAtu("FIM")
        Return .F.
    EndIf

    ::cJustificativa := AllTrim(_cJustifZZ2Ass)

    lRet := ::GravaLog()

    If !lRet
        MsgStop("Falha ao gravar o log de auditoria de um ou mais itens da Assinatura Transferência.", "Auditoria")
        ProcLogAtu("MENSAGEM", "FALHA", "Falha ao gravar log de auditoria via ZZ2GravaLog.")
    Else
        ProcLogAtu("MENSAGEM", "SUCESSO", "Senha validada. Assinatura Transferência confirmada: " + CRLF + ::MontaMsgItens())
    EndIf

    ProcLogAtu("FIM")

Return lRet

/*/{Protheus.doc} GravaAutomatico
Grava o log de auditoria de todos os itens (aItens) sem exibir o
dialogo de Assinatura Eletrônica, para uso em execucao automatica/sem
interface (Job, API, ExecAuto), onde nao ha usuario interativo para
validar Senha.
@type method
@author Pablo Regis
@since 24/09/2026
@param cJustificativa, character, "Justificativa a ser gravada em todos os itens"
@return logical, ".T. se todos os itens foram gravados com sucesso"
/*/
Method GravaAutomatico(cJustificativa as Character) as Logical Class ZZ2AssinaEletronica

    ::cJustificativa := AllTrim(cJustificativa)

Return ::GravaLog()

/*/{Protheus.doc} GetJustificativa
Retorna a justificativa informada pelo usuario na ultima chamada de
Confirma()/GravaAutomatico() bem sucedida.
@type method
@author Pablo Regis
@since 24/09/2026
@return character, "Justificativa informada, ou vazio se ainda nao confirmada"
/*/
Method GetJustificativa() as Character Class ZZ2AssinaEletronica
Return ::cJustificativa

/*/{Protheus.doc} MontaMsgItens
Monta a mensagem consolidada "Produto / Qtde / Origem / Destino" de
todos os itens em aItens, exibida no log de INFO.
@type method
@author Pablo Regis
@since 24/09/2026
@return character, "Mensagem consolidada, uma linha por item"
/*/
Method MontaMsgItens() as Character Class ZZ2AssinaEletronica

    Local cMsg := "" as Character
    Local nI   := 0  as Numeric

    For nI := 1 To Len(::aItens)
        If ::nPosTipo > 0
            cMsg += "Tipo: " + AllTrim(::aItens[nI][::nPosTipo]) + " | "
        EndIf
        cMsg += "Produto: " + AllTrim(::aItens[nI][::nPosProduto]) + ;
            " | Qtde: " + AllTrim(Str(::aItens[nI][::nPosQuant])) + ;
            " | Armazem Origem: " + AllTrim(::aItens[nI][::nPosArmOri]) + ;
            " | Armazem Destino: " + AllTrim(::aItens[nI][::nPosArmDes]) + CRLF
    Next nI

Return cMsg

/*/{Protheus.doc} ValidaSenha
Valida a senha digitada contra a senha do proprio usuario logado,
usando o mesmo criterio ja em producao em ZZ1AssinaEletronica
(ZZ1U002.tlpp): PswOrder(2) + PswSeek(cNomUsr, .T.), comparando o valor
bruto retornado por PswRet() e, como alternativa, PswName().
@type method
@author Pablo Regis
@since 24/09/2026
@param cSenha, character, "Senha digitada pelo usuario a validar"
@return logical, ".T. se a senha do usuario logado esta correta"
/*/
Method ValidaSenha(cSenha as Character) as Logical Class ZZ2AssinaEletronica

    Local cNomUsr := AllTrim(UsrRetName(RetCodUsr())) as Character
    Local aRetPsw as Array
    Local lRet    := .F. as Logical

    PswOrder(2)
    If PswSeek(cNomUsr, .T.)
        aRetPsw := PswRet()
        If AllTrim(aRetPsw[1][3]) == AllTrim(cSenha)
            lRet := .T.
        ElseIf PswName(AllTrim(cSenha))
            lRet := .T.
        EndIf
    EndIf

Return lRet

/*/{Protheus.doc} ValidaCampos
Valida, nesta ordem, a obrigatoriedade da Justificativa e a Senha
digitadas no dialogo de confirmação, exibindo o respectivo MsgAlert
quando invalido. Chamada pelo botao de confirmar do dialogo montado em
Confirma().
@type method
@author Pablo Regis
@since 24/09/2026
@param cSenha, character, "Senha digitada"
@param cJustif, character, "Justificativa digitada"
@return logical, ".T. se Justificativa e Senha sao ambas validas"
/*/
Method ValidaCampos(cSenha as Character, cJustif as Character) as Logical Class ZZ2AssinaEletronica

    If Empty(AllTrim(cJustif))
        MsgAlert("Informe a justificativa da Assinatura Transferência antes de confirmar.", "Atencao")
        Return .F.
    EndIf

    If !::ValidaSenha(cSenha)
        MsgAlert("Senha invalida.", "Autenticacao")
        Return .F.
    EndIf

Return .T.

/*/{Protheus.doc} FechaSeValido
Fecha o dialogo de confirmação somente quando a validacao dos campos
foi bem sucedida, mantendo a tela aberta para o usuario corrigir os
dados em caso de falha.
@type method
@author Pablo Regis
@since 24/09/2026
@param oDlg, object, "Dialogo de confirmação"
@param lValido, logical, ".T. fecha o dialogo"
@return logical, "o proprio valor de lValido recebido"
/*/
Method FechaSeValido(oDlg as Object, lValido as Logical) as Logical Class ZZ2AssinaEletronica

    If lValido
        Close(oDlg)
    EndIf

Return lValido

/*/{Protheus.doc} GravaLog
Percorre todos os itens em aItens e grava um registro de auditoria por
item no log da ZZ2 via U_ZZ2GravaLog (ver CI04A003.tlpp), usando a
Justificativa confirmada em Confirma()/GravaAutomatico().
@type method
@author Pablo Regis
@since 24/09/2026
@return logical, ".T. se todos os itens foram gravados com sucesso"
/*/
Method GravaLog() as Logical Class ZZ2AssinaEletronica

    Local nI       := 0  as Numeric
    Local lRet     := .T. as Logical
    Local cProduto := ""  as Character
    Local nQuant   := 0   as Numeric
    Local cArmOri  := ""  as Character
    Local cArmDes  := ""  as Character
    Local cJustif  := ""  as Character

    For nI := 1 To Len(::aItens)

        cProduto := AllTrim(::aItens[nI][::nPosProduto])
        nQuant   := ::aItens[nI][::nPosQuant]
        cArmOri  := AllTrim(::aItens[nI][::nPosArmOri])
        cArmDes  := AllTrim(::aItens[nI][::nPosArmDes])
        cJustif  := ::cJustificativa

        If ::nPosTipo > 0
            cJustif := "[" + AllTrim(::aItens[nI][::nPosTipo]) + "] " + ::cJustificativa
        EndIf

        If !U_ZZ2GravaLog(::cRotina, ::cDocNum, cProduto, nQuant, cArmOri, cArmDes, cJustif, ::cOrigem)
            lRet := .F.
        EndIf

    Next nI

Return lRet

/*/{Protheus.doc} fConfirmaZZ2AssEle
Valida a obrigatoriedade da Justificativa e a Senha de login antes de
permitir o fechamento do dialogo classico de Assinatura Eletrônica
montado em ZZ2AssinaEletronica:Confirma(). Existe como Static Function
(fora da classe) porque o BMPBUTTON classico so aceita uma chamada de
funcao simples em ACTION, e aciona a instancia da classe guardada na
Private _oSelfZZ2Ass.
@type function
@author Pablo Regis
@since 24/09/2026
@return logical, ".T. se os dados informados sao validos e o dialogo foi fechado"
/*/
Static Function fConfirmaZZ2AssEle() as Logical

    _lOpZZ2Ass := _oSelfZZ2Ass:ValidaCampos(_cSenhaZZ2Ass, _cJustifZZ2Ass)
    _oSelfZZ2Ass:FechaSeValido(_oDlgZZ2Ass, _lOpZZ2Ass)

Return _lOpZZ2Ass
